-- Count selected targets
local function CountSelectedTargets()
    local count = 0
    for _ in pairs(SelectedTargets) do
        count = count + 1
    end
    return count
end

-- Update status display
local function UpdateStatus()
    local count = CountSelectedTargets()
    local totalPlayers = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player then totalPlayers = totalPlayers + 1 end
    end
    CountLabel.Text = count .. "/" .. totalPlayers

    if FlingActive then
        StatusLabel.Text = "Flinging " .. count .. " target(s)..."
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 130)
    else
        if count == 0 then
            StatusLabel.Text = "Select targets to fling"
            StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 190)
        else
            StatusLabel.Text = count .. " target(s) selected"
            StatusLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
        end
    end
end

-- Function to select/deselect all players
local function ToggleAllPlayers(selectAll)
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= Player then
            local checkboxData = PlayerCheckboxes[targetPlayer.Name]
            if checkboxData then
                if selectAll then
                    SelectedTargets[targetPlayer.Name] = targetPlayer
                    checkboxData.Checkmark.Visible = true
                    checkboxData.Highlight.Visible = true
                    Tween(checkboxData.Checkbox, {BackgroundColor3 = Color3.fromRGB(0, 170, 100)}, 0.15)
                else
                    SelectedTargets[targetPlayer.Name] = nil
                    checkboxData.Checkmark.Visible = false
                    checkboxData.Highlight.Visible = false
                    Tween(checkboxData.Checkbox, {BackgroundColor3 = Color3.fromRGB(50, 50, 58)}, 0.15)
                end
            end
        end
    end
    UpdateStatus()
end

